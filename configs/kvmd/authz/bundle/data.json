{
    "_comment": [
        "Global users and roles. Edit this file to match your organisation.",
        "Per-device config lives in data/devices/<device-id>/data.json.",
        "See policy/authz.rego for full documentation of the policy logic.",
        "",
        "Roles can come from users{} (static, per-account) and/or group_roles{}",
        "(dynamic, via IdP group membership claims e.g. from OIDC) — see the",
        "group_roles example below. A user gets the union of both."
    ],
    "users": {
        "admin": { "roles": ["admin"] }
    },
    "group_roles": {
        "kvmd-admins": ["admin"],
        "kvmd-operators": ["operator"]
    },
    "roles": {
        "admin": {
            "permissions": ["*"]
        },
        "operator": {
            "permissions": [
                "switch.port.activate",
                "switch.port.navigate",
                "switch.atx",
                "hid",
                "streamer.view",
                "snapshot",
                "msd.add",
                "msd.mount",
                "gpio"
            ]
        },
        "viewer": {
            "permissions": [
                "streamer.view"
            ]
        }
    }
}
