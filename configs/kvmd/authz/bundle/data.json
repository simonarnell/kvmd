{
    "users": {
        "admin": { "roles": ["admin"] }
    },
    "group_roles": {
        "kvmd-admins": ["admin"],
        "kvmd-operators": ["operator"]
    },
    "roles": {
        "admin": {
            "permissions": ["*"]
        },
        "operator": {
            "permissions": [
                "switch.port.activate",
                "switch.port.navigate",
                "switch.atx",
                "hid",
                "streamer.view",
                "snapshot",
                "msd.add",
                "msd.mount",
                "gpio"
            ]
        },
        "viewer": {
            "permissions": [
                "streamer.view"
            ]
        }
    }
}
