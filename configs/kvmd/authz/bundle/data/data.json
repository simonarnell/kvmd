{
    "_comment": [
        "Global users and roles. Works for both switch and standalone deployments.",
        "Per-device config lives in data/devices/<device-id>/data.json:",
        "  Switch device:     add port_permissions to restrict roles per port.",
        "  Standalone device: add { \"standalone\": true } — no port_permissions needed.",
        "See policy/authz.rego for the full policy logic and deployment mode docs."
    ],
    "users": {
        "alice":   { "roles": ["superuser"] },
        "bob":     { "roles": ["operator"] },
        "carol":   { "roles": ["viewer"] },
        "wbob":    { "roles": ["wintel-admin"] },
        "lcarol":  { "roles": ["lintel-admin"] }
    },
    "roles": {
        "superuser": {
            "permissions": ["*"]
        },
        "operator": {
            "permissions": [
                "switch.port.activate",
                "switch.port.navigate",
                "switch.atx",
                "hid",
                "streamer"
            ]
        },
        "viewer": {
            "permissions": [
                "streamer"
            ]
        },
        "wintel-admin": {
            "permissions": [
                "switch.port.activate",
                "switch.port.navigate",
                "switch.atx",
                "hid",
                "streamer"
            ]
        },
        "lintel-admin": {
            "permissions": [
                "switch.port.activate",
                "switch.port.navigate",
                "hid",
                "streamer"
            ]
        }
    }
}
